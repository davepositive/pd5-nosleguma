import sqlite3


def connect():
    return sqlite3.connect("data/app.db")


def create_tables():
    conn = connect()
    cursor = conn.cursor()

    # Lietotāju tabula
    cursor.execute("""
    CREATE TABLE IF NOT EXISTS users (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        username TEXT UNIQUE,
        password TEXT
    )
    """)

    # Uzdevumu tabula
    cursor.execute("""
    CREATE TABLE IF NOT EXISTS tasks (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        task TEXT,
        done INTEGER,
        user_id INTEGER,
        FOREIGN KEY(user_id) REFERENCES users(id)
    )
    """)

    conn.commit()
    conn.close()

from database import connect


def login(username, password):
    conn = connect()
    cursor = conn.cursor()

    cursor.execute(
        "SELECT * FROM users WHERE username=? AND password=?",
        (username, password)
    )

    user = cursor.fetchone()

    conn.close()

    return user

from database import connect


def add_task(task, user_id):
    conn = connect()
    cursor = conn.cursor()

    cursor.execute(
        "INSERT INTO tasks(task, done, user_id) VALUES (?, ?, ?)",
        (task, 0, user_id)
    )

    conn.commit()
    conn.close()


def get_tasks(user_id):
    conn = connect()
    cursor = conn.cursor()

    cursor.execute(
        "SELECT * FROM tasks WHERE user_id=?",
        (user_id,)
    )

    tasks = cursor.fetchall()

    conn.close()

    return tasks


def delete_task(task_id):
    conn = connect()
    cursor = conn.cursor()

    cursor.execute(
        "DELETE FROM tasks WHERE id=?",
        (task_id,)
    )

    conn.commit()
    conn.close()

import tkinter as tk
from tkinter import messagebox

from database import create_tables
from task_manager import add_task, get_tasks


def run_app():
    create_tables()

    root = tk.Tk()
    root.title("Mājasdarbu pārvaldnieks")
    root.geometry("500x400")

    title = tk.Label(
        root,
        text="Mājasdarbu pārvaldnieks",
        font=("Arial", 16)
    )

    title.pack(pady=10)

    task_entry = tk.Entry(root, width=40)
    task_entry.pack(pady=10)

    task_listbox = tk.Listbox(root, width=50)
    task_listbox.pack(pady=10)

    USER_ID = 1

    def load_tasks():
        task_listbox.delete(0, tk.END)

        tasks = get_tasks(USER_ID)

        for task in tasks:
            task_listbox.insert(tk.END, task[1])

    def save_task():
        task = task_entry.get()

        if task != "":
            add_task(task, USER_ID)

            task_entry.delete(0, tk.END)

            load_tasks()

        else:
            messagebox.showwarning(
                "Kļūda",
                "Ievadi uzdevumu"
            )

    add_button = tk.Button(
        root,
        text="Pievienot",
        command=save_task
    )

    add_button.pack(pady=5)

    load_tasks()

    root.mainloop()

